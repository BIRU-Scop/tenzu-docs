DOMAIN_NAME='example.domain.name'
TENZU_DB__PASSWORD='a-strong-password'
TENZU_SECRET_KEY='a-strong-secret-key'
TENZU_TOKENS__SIGNING_KEY='a-different-strong-secret-key'

# Email delivery, see the "Email delivery" page of the documentation
TENZU_EMAIL__DEFAULT_FROM_EMAIL='tenzu@example.domain.name'
TENZU_EMAIL__EMAIL_HOST='smtp.example.domain.name'
TENZU_EMAIL__EMAIL_PORT='587'
TENZU_EMAIL__EMAIL_HOST_USER='smtp-user'
TENZU_EMAIL__EMAIL_HOST_PASSWORD='a-strong-smtp-password'
TENZU_EMAIL__EMAIL_USE_TLS='true'
TENZU_EMAIL__EMAIL_USE_SSL='false'
# Contact address shown in the emails sent to users
TENZU_SUPPORT_EMAIL='support@example.domain.name'
